{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Golf Course Import Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "courses"],
    "properties": {
      "name": {
        "type": "string",
        "description": "골프장 이름 (예: 안양 CC)"
      },
      "address": {
        "type": "string",
        "description": "골프장 주소 (선택 사항)"
      },
      "courses": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "holes"],
          "properties": {
            "name": {
              "type": "string",
              "description": "코스 이름 (예: OUT, IN, 서코스)"
            },
            "holes": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "type": "object",
                "required": ["holeNumber", "par", "distances"],
                "properties": {
                  "holeNumber": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                  },
                  "par": {
                    "type": "integer",
                    "enum": [3, 4, 5, 6]
                  },
                  "distances": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["teeColor", "distanceMeter"],
                      "properties": {
                        "teeColor": {
                          "type": "string",
                          "enum": ["Black", "Blue", "White", "Red", "Gold", "Green"]
                        },
                        "distanceMeter": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
